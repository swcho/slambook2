{
  "name": "ch13-wasm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:wasm:baseline": "bash wasm-src/build.sh baseline",
    "build:wasm:simd": "bash wasm-src/build.sh simd",
    "build:wasm:mt": "bash wasm-src/build.sh mt",
    "build:wasm:mt-simd": "bash wasm-src/build.sh mt-simd",
    "build:wasm:camera": "bash wasm-src/build.sh baseline camera",
    "build:opencv:baseline": "bash wasm-src/scripts/build-opencv.sh baseline",
    "build:wasm:cv_spike": "bash wasm-src/build.sh baseline cv_spike",
    "verify:cv_spike": "node --experimental-strip-types wasm-src/spike/verify_cv.ts",
    "build:wasm:features": "bash wasm-src/build.sh baseline features",
    "verify:features": "node --experimental-strip-types wasm-src/spike/verify_features.ts",
    "build:wasm:triangulation": "bash wasm-src/build.sh baseline triangulation",
    "verify:triangulation": "node --experimental-strip-types wasm-src/spike/verify_triangulation.ts",
    "build:wasm:pnp": "bash wasm-src/build.sh baseline pnp",
    "verify:pnp": "node --experimental-strip-types wasm-src/spike/verify_pnp.ts",
    "build:wasm:ba": "bash wasm-src/build.sh baseline ba",
    "verify:ba": "node --experimental-strip-types wasm-src/spike/verify_ba.ts",
    "verify:slam": "node --experimental-strip-types wasm-src/spike/verify_slam.ts",
    "gen:dataset": "node --experimental-strip-types scripts/gen-kitti-mini.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "verify:py": "cd python && uv run pytest -v",
    "verify:py:steps": "cd python && for s in step01_dataset step02_camera step03_feature_detection step04_stereo_matching step05_triangulation step06_initial_map step07_frame_tracking step08_pose_estimation step09_keyframe_decision step10_new_map_points step11_bundle_adjustment step12_sliding_window step13_full_pipeline; do echo \"=== $s ===\"; uv run python scripts/$s.py | tail -1 || exit 1; done"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.100.1",
    "@types/three": "^0.184.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.184.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
