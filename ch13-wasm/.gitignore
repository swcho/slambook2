node_modules/
dist/
.vite/
*.log

# Playwright (e2e smoke)
playwright-report/
test-results/
tsconfig.test.tsbuildinfo

# WASM build outputs (built artifacts land in public/wasm via build.sh)
public/wasm/*.wasm
public/wasm/*.js
public/wasm/*.data
public/wasm/*.mem
wasm-src/build/

# Re-include: the repo-root .gitignore has a broad `**build**` glob that
# otherwise swallows build.sh. (wasm-src/build/ above still ignores the dir.)
!wasm-src/build.sh
!wasm-src/scripts/
!wasm-src/scripts/build-opencv.sh


# emsdk / third-party (if vendored later as plain copies, not submodules)
wasm-src/third_party/emsdk/
wasm-src/third_party/sophus/
wasm-src/third_party/opencv-minimal/
wasm-src/third_party/cxsparse/
# g2o, eigen, and opencv live here as git submodules (see .gitmodules) — explicitly tracked.

# Python reference (uv-managed)
python/.venv/
python/__pycache__/
python/**/__pycache__/
python/.pytest_cache/
python/.ipynb_checkpoints/
python/**/.ipynb_checkpoints/
